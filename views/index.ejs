<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>P1 Sistema complet amb autenticació i CRUD</h1>
    <p>Benvingut a la pagina principal</p>

    <%if (typeof username!='undefined') { %>
        <p>Ves al panel d'administrador per fer servir el CRUD</p>
        <a href="/auth/protected">Panal administrador</a>
    <% } %>

    <% if (typeof username==='undefined') { %>
        <p>Per començar a utilitzar el CRUD si us plau fes login o register</p>
        <a href="/auth/login"> Login </a>
        <a href="/auth/register"> Register </a>
    <% } %>
</body>
</html>